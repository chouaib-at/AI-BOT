# Market data provider (CoinGecko by default).
# CoinGecko's public API is heavily rate-limited without a key and a full
# scan makes 100+ requests, so a 429 error is expected sooner or later.
# Get a free Demo API key (no card required) at
# https://www.coingecko.com/en/api/pricing and paste it below — keep the
# base URL as api.coingecko.com for a Demo key (only a paid Pro key uses
# pro-api.coingecko.com).
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=
VS_CURRENCY=usd

# Universe selection
CANDIDATE_POOL_SIZE=60
TOP_N_COINS=10
MIN_24H_VOLUME_USD=20000000
MIN_MARKET_CAP_USD=50000000

# Risk management
DEFAULT_ACCOUNT_BALANCE=1000
MAX_RISK_PER_TRADE_PCT=1
MIN_RISK_REWARD=1.5
PREFERRED_RISK_REWARD=2

# Scheduler
SCAN_INTERVAL_MINUTES=60

# Safety: analysis/signal-generation only. Never wired to a broker in this
# codebase — leave false unless you have built and audited an execution module.
EXECUTION_ENABLED=false
